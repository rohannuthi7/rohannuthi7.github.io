---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found — ${site.name}`} description="That page does not exist." ogImage="/og/home.png">
  <section class="container notfound">
    <h1 class="h2">Page not found</h1>
    <p class="body">There is nothing at this address. <a href="/">Go back to the home page</a>.</p>
  </section>
</Base>
