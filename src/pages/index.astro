---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ContactList from '../components/ContactList.astro';
import ProjectDeck from '../components/ProjectDeck.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Tag from '../components/Tag.astro';
import WordTree from '../components/WordTree.astro';
import { site } from '../data/site';
import { coursework, catalogNumber } from '../data/coursework';
import { skills } from '../data/skills';
import { byStartDesc } from '../lib/dates';
import signatureSvg from '../assets/signature.svg?raw';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort(byStartDesc);
// The signature again, large and faint behind the intro. Decorative: the
// footer copy carries the accessible name.
const watermark = signatureSvg.replace(/ role="img" aria-label="[^"]*" class="signature"/, ' aria-hidden="true" focusable="false" class="intro-signature"');
// A skill is "used" when a project on this page lists it in its stack, either
// by the same name or as a word inside the skill's label ("PostgreSQL" in
// "SQL (PostgreSQL)", "AWS" in "AWS (EC2, S3, Lambda)").
const stackNames = new Set(projects.flatMap((p) => p.data.stack));
const usedInProject = (skill: string) =>
  stackNames.has(skill) || skill.split(/[\s(),]+/).some((word) => stackNames.has(word));
// The coursework table shows its "What I built" and "Used in" columns only
// once at least one course has them filled in (src/data/coursework.ts).
const anyBuilt = coursework.some((c) => c.built);
const anyUsed = coursework.some((c) => c.project);
const byNumber = (a: { number: string }, b: { number: string }) => catalogNumber(b) - catalogNumber(a);
---
<Base title={site.title} description={site.description} ogImage="/og/home.png" signature>
  <div class="intro">
  <Fragment set:html={watermark} />
  <header id="about" class="container hero">
    <h1>{site.name}</h1>
    {site.currently && <p class="currently">Currently: {site.currently}</p>}
  </header>

  <section class="container about" aria-label="About">
    <div class="headshot-frame">
      <Image class="headshot" src={site.headshot.src} alt={site.headshot.alt} width={320} height={598} loading="eager" />
    </div>
    <div class="about-text">
      <p class="lede">{site.bio || site.description}</p>
      <dl class="ledger hero-facts">
        {site.facts.map((f) => (
          <div class="ledger-row"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
        <div class="ledger-row">
          <dt>Fraternity</dt>
          <dd class="mark"><span class="mark-badge"><Image src={site.fraternity.mark} alt={`${site.fraternity.name} logo`} width={160} height={160} /></span><span>{site.fraternity.name}</span></dd>
        </div>
      </dl>
      <div class="btn-row">
        <Button href={site.resume} external>View resume</Button>
        <Button href="#projects" variant="secondary">Selected projects</Button>
      </div>
    </div>
    <div class="about-contact">
      <h2 id="contact" class="col-head">Contact</h2>
      <ContactList />
    </div>
  </section>
  </div>

  <ProjectDeck projects={projects} />

  <section id="coursework" class="section section-case">
    <div class="container">
      <h2 class="big-title">Coursework</h2>
      <table class="courses">
        <thead>
          <tr>
            <th scope="col">Course</th>
            <th scope="col">{anyBuilt ? 'What I built' : 'Topics'}</th>
            {anyUsed && <th scope="col">Used in</th>}
          </tr>
        </thead>
        <tbody>
          {[...coursework].sort(byNumber).map((c) => {
            const used = projects.find((p) => p.id === c.project);
            return (
              <tr>
                <th scope="row" class="course-name">
                  {c.name}
                  <span class="course-num">{c.number}{c.term && ` (${c.term})`}</span>
                </th>
                <td class="course-built">
                  {c.built && <p class="course-sentence">{c.built}</p>}
                  <p class={c.built ? 'course-topics' : 'course-topics is-main'}>{c.topics}</p>
                </td>
                {anyUsed && <td class="course-used">{used && <a href={`/projects/${used.id}`}>{used.data.title}</a>}</td>}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container">
      <h2 class="big-title">Experience</h2>
      <ul class="timeline">
        {experience.map((entry) => <ExperienceEntry entry={entry} />)}
      </ul>
    </div>
  </section>

  <section id="guestbook" class="section">
    <div class="container">
      <h2 class="big-title">Guestbook</h2>
      <WordTree />
    </div>
  </section>

  <section id="skills" class="section section-tint">
    <div class="container">
      <h2 class="big-title">Skills</h2>
      <div class="skill-rows">
        {skills.map((row) => (
          <div class="lrow">
            <p class="skill-label">{row.category}</p>
            <ul class="chips">{row.items.map((s) => <Tag label={s} used={usedInProject(s)} />)}</ul>
          </div>
        ))}
      </div>
      <p class="skill-legend" aria-hidden="true"><span class="skill-swatch"></span>Used in a project on this page</p>
    </div>
  </section>
</Base>
