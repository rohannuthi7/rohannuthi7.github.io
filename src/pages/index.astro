---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import ContactList from '../components/ContactList.astro';
import ProjectDeck from '../components/ProjectDeck.astro';
import ExperienceEntry from '../components/ExperienceEntry.astro';
import Tag from '../components/Tag.astro';
import { site } from '../data/site';
import { coursework, catalogNumber } from '../data/coursework';
import { skills } from '../data/skills';
import { byStartDesc } from '../lib/dates';
import signatureSvg from '../assets/signature.svg?raw';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const experience = (await getCollection('experience')).sort(byStartDesc);
// The signature again, large and faint behind the intro. Decorative: the
// footer copy carries the accessible name.
const watermark = signatureSvg.replace(/ role="img" aria-label="[^"]*" class="signature"/, ' aria-hidden="true" focusable="false" class="intro-signature"');
const byNumber = (a: { number: string }, b: { number: string }) => catalogNumber(a) - catalogNumber(b);
---
<Base title={site.title} description={site.description} ogImage="/og/home.png" signature>
  <div class="intro">
  <Fragment set:html={watermark} />
  <header id="about" class="container hero">
    <p class="kicker">{site.kicker}</p>
    <h1>{site.name}</h1>
    {site.currently && <p class="currently">Currently: {site.currently}</p>}
  </header>

  <section class="container about" aria-label="About">
    <div class="headshot-frame">
      <Image class="headshot" src={site.headshot.src} alt={site.headshot.alt} width={320} height={598} loading="eager" />
    </div>
    <div class="about-text">
      <p class="lede">{site.description}</p>
      <p class="kicker honours">
        <span class="mark"><span class="mark-badge"><Image src={site.fraternity.mark} alt={`${site.fraternity.name} logo`} width={160} height={160} /></span><span>{site.fraternity.name}</span></span>
        {site.honours.map((h) => <><span aria-hidden="true">·</span><span>{h}</span></>)}
      </p>
      <div class="btn-row">
        <Button href="#projects" variant="secondary">Selected projects</Button>
      </div>
    </div>
    <div class="about-contact">
      <h2 id="contact" class="col-head">Contact</h2>
      <ContactList />
    </div>
  </section>
  </div>

  <ProjectDeck projects={projects} />

  <section id="coursework" class="section section-tint">
    <div class="container">
      <h2 class="h2 section-title">Coursework</h2>
      <ul class="courses">
        {[...coursework].sort(byNumber).map((c) => (
          <li class="course">
            <span class="course-num">{c.number}</span>
            <span class="course-title">{c.title}{c.term && <span class="kicker term">{c.term}</span>}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="container">
      <h2 class="h2 section-title">Experience</h2>
      <ul class="timeline">
        {experience.map((entry) => <ExperienceEntry entry={entry} />)}
      </ul>
    </div>
  </section>

  <section id="skills" class="section section-tint">
    <div class="container stack">
      <h2 class="h2 section-title">Skills</h2>
      {skills.map((row) => (
        <div class="lrow">
          <p class="kicker">{row.category}</p>
          <ul class="chips">{row.items.map((s) => <Tag label={s} />)}</ul>
        </div>
      ))}
    </div>
  </section>
</Base>
