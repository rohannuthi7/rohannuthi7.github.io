---
// /guestbook: visitors' notes grow as leaves on a tree built from an AVL tree.
import Base from '../layouts/Base.astro';
import GuestbookTree from '../components/GuestbookTree.astro';
import { site } from '../data/site';
import { treeConfig } from '../data/tree';

const legend = [
  { kind: 'encouragement', label: 'Encouragement' },
  { kind: 'fun_fact', label: 'Fun fact' },
  { kind: 'other', label: 'Other' },
  { kind: 'pinned', label: 'From Rohan' },
];
---
<Base title={`Guestbook — ${site.name}`} description="Leave a short note for Rohan. Each approved note grows as a leaf on a tree drawn from an AVL tree he built from scratch." ogImage="/og/guestbook.png">
  <section class="container guestbook">
    <div class="gb-intro">
      <p class="kicker">Guestbook</p>
      <h1 class="gb-title">Leave a leaf</h1>
      <p class="lede">A word of encouragement, a fun fact, anything short. Once I’ve read a note, it grows as a leaf on this tree. Hover or tap a leaf to read it.</p>
      {treeConfig.sampleData && <p class="kicker">Sample notes shown until the guestbook opens.</p>}
      <ul class="gb-legend" aria-label="Leaf colours">
        {legend.map((l) => <li><span class="gb-dot" data-kind={l.kind}></span>{l.label}</li>)}
      </ul>
      <div class="gb-plaque">
        <h2 class="col-head">How this tree was built</h2>
        {treeConfig.plaque.map((p) => <p class="gb-plaque-text">{p}</p>)}
      </div>
    </div>
    <div class="gb-tree">
      <GuestbookTree />
    </div>
  </section>
</Base>
