---
import { getCollection } from 'astro:content';
import Case from '../../layouts/Case.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project, projects } }));
}

const { project, projects } = Astro.props;
---
<Case project={project} projects={projects} />
