---
// One card in the Projects deck. The whole card is a link to the case study.
// Three bands: a photo strip whose hovered frame expands, a two-column info
// area (title + blurb, stats ledger) that is always visible, and a "View
// project" bar that fills with the project's own colour on hover (always
// filled on touch screens).
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import reaxeRound from '../assets/reaxe-round.svg?raw';

interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const { data } = project;

// Card frames default to the first three collage photos.
const frames = data.frames ?? data.collage.slice(0, 3);
// The stack is always the last row of the ledger.
const rows = [...data.stats, { label: 'Stack', value: data.stack.join(', '), accent: false }];

// A project's own round logo beside its title.
const logos: Record<string, string> = { reaxe: reaxeRound };
const logo = logos[project.id]?.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');

// Back-face icons on the waiting cards' tabs: generic line drawings, never logos.
const backIcons: Record<string, string> = {
  // Paddle and ball.
  pickleiq: '<rect x="4" y="3" width="10" height="11" rx="5"/><path d="M9 14v7"/><circle cx="18.5" cy="17.5" r="2.5"/>',
  // A video frame with a play mark and a magnifier: searching surgery video.
  'surg-f': '<rect x="3" y="4" width="14" height="11" rx="1.5"/><path d="M8.5 7.5v4.5l3.5-2.25z"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M19.3 19.3L21.5 21.5"/>',
  // A chip with pins: the FPGA.
  synapse: '<rect x="7" y="7" width="10" height="10" rx="1"/><rect x="10" y="10" width="4" height="4"/><path d="M10 7V4M14 7V4M10 20v-3M14 20v-3M7 10H4M7 14H4M20 10h-3M20 14h-3"/>',
  // A leaf: the guestbook tree.
  guestbook: '<path d="M5 19c0-8 5-14 14-14 0 9-6 14-14 14z"/><path d="M5 19l7-7"/>',
  // A house and a ruler line: home remodeling.
  reaxe: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-6h4v6"/>',
};
---
<a class="card" href={`/projects/${project.id}`} style={`--i:${index}; --project: var(--project-${project.id}); --project-on: var(--project-${project.id}-on)`}>
  <div class="strip">
    {frames.map((f, k) => (
      <div class={`frame${k === 0 ? ' is-active' : ''}`} data-frame={k} style={`--ar:${(f.src.width / f.src.height).toFixed(3)}`}>
        <Image src={f.src} alt={f.alt} width={Math.min(1400, f.src.width)} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" style={k === 0 ? `view-transition-name: cover-${project.id}` : undefined} />
      </div>
    ))}
  </div>
  <div class="card-info">
    <div class="card-text">
      {logo
        ? <div class="card-title-row"><span class="card-logo" set:html={logo} /><h3 class="card-title">{data.title}</h3></div>
        : <h3 class="card-title">{data.title}</h3>}
      <p class="card-blurb">{data.summary}</p>
    </div>
    <dl class="ledger">
      {rows.map((r) => (
        <div class="ledger-row">
          <dt>{r.label}</dt>
          <dd class={r.accent ? 'is-accent' : undefined}>{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="card-bar" aria-hidden="true">
    <span class="card-bar-label">View project</span>
    <span class="card-bar-arrow"><Icon name="chevron-right" size={16} /></span>
  </div>
  <div class="card-back" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={backIcons[project.id] ?? backIcons.reaxe} />
  </div>
</a>
