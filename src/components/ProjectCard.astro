---
// One card in the Projects deck. The whole card is a link to the case study.
// Three bands: a photo strip whose hovered frame expands, a two-column info
// area (title + blurb, stats ledger) and an action bar that fills with the
// accent colour when the card is hovered.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const { data } = project;

// Card frames default to the first three collage photos.
const frames = data.frames ?? data.collage.slice(0, 3);
// The stack is always the last row of the ledger.
const rows = [...data.stats, { label: 'stack', value: data.stack.join(', '), accent: false }];
const pad = (n: number) => String(n).padStart(2, '0');

// Back-face icons: generic line drawings, never logos.
const backIcons: Record<string, string> = {
  pickleiq: '<circle cx="12" cy="12" r="9"/><circle cx="9" cy="9" r=".9"/><circle cx="15" cy="9" r=".9"/><circle cx="12" cy="13" r=".9"/><circle cx="9" cy="16" r=".9"/><circle cx="15" cy="16" r=".9"/>',
  reaxe: '<path d="M4 11l8-7 8 7"/><path d="M6 10v10h12V10"/><path d="M10 20v-6h4v6"/>',
  'badger-solar-racing': '<circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/>',
  'wisconsin-humanoid': '<path d="M4 20l5-8 6 2 5-9"/><circle cx="4" cy="20" r="1.5"/><circle cx="9" cy="12" r="1.5"/><circle cx="15" cy="14" r="1.5"/>',
};
---
<a class="card" href={`/projects/${project.id}`} aria-label={`${data.title} case study`} style={`--i:${index}`}>
  <div class="strip">
    {frames.map((f, k) => (
      <div class={`frame${k === 0 ? ' is-active' : ''}`} data-frame={k}>
        <Image src={f.src} alt={f.alt} width={1200} height={720} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" style={k === 0 ? `view-transition-name: cover-${project.id}` : undefined} />
      </div>
    ))}
  </div>
  <div class="card-info">
    <div class="card-text">
      <div class="card-title-row">
        <h3 class="card-title">{data.title}</h3>
        <span class="card-counter" aria-hidden="true"><span class="card-counter-n">01</span> / {pad(frames.length)}</span>
      </div>
      <p class="card-blurb">{data.summary}</p>
    </div>
    <dl class="ledger">
      {rows.map((r) => (
        <div class="ledger-row">
          <dt>{r.label}</dt>
          <dd class={r.accent ? 'is-accent' : undefined}>{r.value}</dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="card-bar" aria-hidden="true">
    <span class="card-bar-label">
      <span class="card-bar-rest">hover the frames · click for the write-up</span>
      <span class="card-bar-hover">open the full write-up</span>
    </span>
    <span class="card-bar-arrow">→</span>
  </div>
  <div class="card-back" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={backIcons[project.id] ?? backIcons.reaxe} />
  </div>
</a>
