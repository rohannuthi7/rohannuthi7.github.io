---
// Image with an optional caption, for use inside case-study bodies.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; width?: number }
const { src, alt, caption, width } = Astro.props;
---
<figure>
  <Image src={src} alt={alt} width={width} loading="lazy" decoding="async" />
  {caption && <figcaption class="kicker">{caption}</figcaption>}
</figure>
