---
// The homepage footer carries the handwritten signature (traced from a scan,
// drawn in currentColor so it follows the theme); other pages omit it.
import signature from '../assets/signature.svg?raw';
import { site } from '../data/site';
const year = new Date().getFullYear();
interface Props { signature?: boolean }
const { signature: showSignature = false } = Astro.props;
---
<footer class="footer">
  <div class="container footer-row">
    <div class="footer-sign">
      {showSignature && <Fragment set:html={signature} />}
      <p>© {year} {site.name}</p>
    </div>
    <a href="/guestbook">Guestbook</a>
  </div>
</footer>
