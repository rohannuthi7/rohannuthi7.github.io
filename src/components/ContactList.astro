---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<ul class="contact">
  <li class="place"><Icon name="pin" /><span>{site.location}</span></li>
  <li><a href={site.github.href} target="_blank" rel="me noopener"><Icon name="github" /><span>{site.github.label}</span></a></li>
  <li><a href={site.linkedin.href} target="_blank" rel="me noopener"><Icon name="linkedin" /><span>{site.linkedin.label}</span></a></li>
  <li><a href={`mailto:${site.email}`}><Icon name="envelope" /><span>{site.email}</span></a></li>
</ul>
