---
// Projects as a pinned card deck. The runway is one viewport-high segment per
// card: the sticky stage is the first segment and holds the cards while the
// remaining segments scroll underneath it.
// Above the cards, a counter shows which card is in front, with buttons to
// jump to each one. Hovering or focusing the front card sweeps a rounded panel
// in behind it and lifts the card forward.
// The script sets the current index on the stage; the cards derive everything
// else from CSS. Without the script, or on phones, the cards simply stack.
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="projects" class="section deck" aria-labelledby="projects-title">
  <div class="container deck-head">
    <h2 id="projects-title" class="deck-title">Projects</h2>
  </div>
  <div class="deck-container runway">
    <div class="stage">
      <div class="deck-now">
        <p class="deck-now-count"><span class="deck-now-i">01</span> / {pad(projects.length)}</p>
        <div class="deck-ticks">
          {projects.map((p, i) => <button type="button" class="deck-tick" aria-label={`Show ${p.data.title}`} aria-current={i === 0 ? 'true' : undefined}></button>)}
        </div>
      </div>
      <div class="cardbox">
        <div class="deck-panel" aria-hidden="true"><div class="deck-panel-shape"></div></div>
        {projects.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
    </div>
    {projects.map((p) => <div class="segment" id={`card-${p.id}`}></div>)}
  </div>
</section>

<script>
  const deck = document.querySelector<HTMLElement>('.deck');
  const stage = deck?.querySelector<HTMLElement>('.stage');
  const runway = deck?.querySelector<HTMLElement>('.runway');
  if (deck && stage && runway && matchMedia('(min-width: 721px)').matches) {
    const cards = Array.from(deck.querySelectorAll<HTMLAnchorElement>('.card'));
    const ticks = Array.from(deck.querySelectorAll<HTMLButtonElement>('.deck-tick'));
    const nowI = deck.querySelector<HTMLElement>('.deck-now-i')!;
    // The stage pins just under the sticky nav and snap points land there too,
    // so distance travelled is measured from the nav's bottom edge.
    const nav = document.querySelector<HTMLElement>('.nav');
    const noHover = matchMedia('(hover: none)');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    deck.setAttribute('data-js', '');
    let index = -1;

    // The panel shows while the front card is hovered or focused (always on touch).
    const setHot = () => {
      const front = cards[index];
      stage.toggleAttribute('data-hot', !!front && (noHover.matches || front.matches(':hover') || front.matches(':focus-visible')));
    };

    const setIndex = (i: number) => {
      if (i === index) return;
      index = i;
      stage.dataset.index = String(i);
      stage.style.setProperty('--index', String(i));
      cards.forEach((c, k) => {
        c.classList.toggle('is-front', k === i);
        c.classList.toggle('is-passed', k < i);
        c.inert = k < i;
      });
      ticks.forEach((t, k) => (k === i ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
      nowI.textContent = String(i + 1).padStart(2, '0');
      stage.removeAttribute('data-hot');
      requestAnimationFrame(setHot);
    };

    // One segment per card follows the stage's own slot, so the last card
    // holds for a full segment before the stage releases.
    const segment = () => (runway.getBoundingClientRect().height - stage.offsetHeight) / cards.length;
    const update = () => {
      const travelled = (nav?.offsetHeight ?? 0) - runway.getBoundingClientRect().top;
      // +2px absorbs sub-pixel rounding when the scroll has snapped exactly to a boundary.
      setIndex(Math.max(0, Math.min(cards.length - 1, Math.floor((2 + travelled) / segment()))));
    };
    // Lands a few pixels into card k's segment, matching update()'s rounding.
    const goTo = (k: number) => {
      const top = scrollY + runway.getBoundingClientRect().top - (nav?.offsetHeight ?? 0) + k * segment() + 4;
      scrollTo({ top, behavior: reduceMotion.matches ? 'auto' : 'smooth' });
    };

    let ticking = false;
    addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    }, { passive: true });
    update();

    // Clicking (or pressing Enter on) a waiting card brings it to the front
    // instead of opening it; the front card still opens its project page.
    cards.forEach((c, k) => {
      c.addEventListener('click', (e) => { if (k > index) { e.preventDefault(); goTo(k); } });
      c.addEventListener('pointerenter', setHot);
      c.addEventListener('pointerleave', setHot);
      c.addEventListener('focusin', setHot);
      c.addEventListener('focusout', () => requestAnimationFrame(setHot));
    });
    ticks.forEach((t, k) => t.addEventListener('click', () => goTo(k)));
  }

  // Photo strip: the hovered frame expands. The active frame stays open after
  // the pointer leaves the strip.
  document.querySelectorAll<HTMLElement>('.deck .card').forEach((card) => {
    const frames = Array.from(card.querySelectorAll<HTMLElement>('.frame'));
    frames.forEach((f, k) => f.addEventListener('pointerenter', () => {
      // In the pinned deck, only the front card's photos respond; a waiting
      // card's strip sits under its clickable tab.
      if (card.closest('[data-js]') && !card.classList.contains('is-front')) return;
      frames.forEach((g, j) => g.classList.toggle('is-active', j === k));
    }));
  });
</script>
