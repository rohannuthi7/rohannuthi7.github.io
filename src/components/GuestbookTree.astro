---
// The guestbook tree, drawn into its panel on /guestbook. The scroll glow
// follows the middle of the viewport along the trunk, leaves near it brighten,
// on-screen leaves sway, and hovering or tapping a leaf shows its note.
// Real notes arrive in stage 5; until then it draws sample data.
---
<div class="gt-stage" aria-hidden="true">
  <svg class="gt-svg" xmlns="http://www.w3.org/2000/svg"></svg>
</div>
<div class="gt-glow" aria-hidden="true"><span class="gt-glow-band"></span></div>
<div class="gt-card" id="gt-card" role="tooltip" hidden>
  <p class="gt-card-kind"><span class="gt-card-dot"></span><span class="gt-card-type"></span></p>
  <p class="gt-card-body"></p>
  <p class="gt-card-meta"></p>
</div>

<script>
  import { buildLeafTree, type Leaf } from '../lib/leaf-tree.ts';
  import { sampleLeaves } from '../lib/tree-fixtures.ts';
  import { layoutTree, panelFrame, treeHeight, type LeafShape, type TreeGeometry } from '../lib/tree-layout.ts';
  import { renderTree } from '../lib/tree-render.ts';
  import { placeCard, rangeByY, trunkXAt } from '../lib/tree-scroll.ts';
  import { treeConfig } from '../data/tree.ts';

  const stage = document.querySelector<HTMLElement>('.gt-stage');
  const svg = stage?.querySelector<SVGSVGElement>('svg');
  const glow = document.querySelector<HTMLElement>('.gt-glow');
  const card = document.querySelector<HTMLElement>('#gt-card');

  const TYPE_LABEL: Record<Leaf['type'], string> = { encouragement: 'Encouragement', fun_fact: 'Fun fact', other: 'Note' };
  const dateFormat = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

  if (stage && svg && glow && card) {
    // Sample data until stage 5 swaps in approved notes from Supabase.
    const data = buildLeafTree(sampleLeaves(), treeConfig.capacity);
    const nodes = data.tree.flatten();
    const pinned = data.pinned.slice(0, treeConfig.pinnedSpots.length).map((leaf, i) => ({ leaf, ...treeConfig.pinnedSpots[i] }));
    const fallen = data.archive.slice(0, 5);
    const leavesById = new Map([...nodes.map((n) => n.item), ...pinned.map((p) => p.leaf)].map((l) => [l.id, l]));

    let geometry: TreeGeometry | null = null;
    let byY: { shape: LeafShape; el: Element }[] = [];
    let ys: number[] = [];
    let stageTop = 0;
    let stageLeft = 0;
    const lit = new Set<Element>();
    const near = new Set<Element>();

    // ── Note cards. Text is set with textContent, never as HTML.
    const kind = card.querySelector<HTMLElement>('.gt-card-type')!;
    const body = card.querySelector<HTMLElement>('.gt-card-body')!;
    const meta = card.querySelector<HTMLElement>('.gt-card-meta')!;
    let current: Element | null = null;
    let hideTimer = 0;
    const showCard = (leafEl: Element) => {
      const leaf = leavesById.get(leafEl.getAttribute('data-id') ?? '');
      if (!leaf) return;
      clearTimeout(hideTimer);
      current?.classList.remove('is-active');
      current = leafEl;
      leafEl.classList.add('is-active');
      card.dataset.kind = leaf.pinned ? 'pinned' : leaf.type;
      kind.textContent = leaf.pinned ? 'From Rohan' : TYPE_LABEL[leaf.type];
      body.textContent = leaf.body;
      meta.textContent = leaf.pinned ? '' : [leaf.name, dateFormat.format(leaf.createdAt)].filter(Boolean).join(' · ');
      meta.hidden = !meta.textContent;
      card.hidden = false;
      const at = placeCard(leafEl.getBoundingClientRect(), { width: card.offsetWidth, height: card.offsetHeight },
        { width: document.documentElement.clientWidth, height: innerHeight });
      card.style.left = `${Math.round(at.left)}px`;
      card.style.top = `${Math.round(at.top)}px`;
      card.classList.add('is-open');
    };
    const hideCard = () => {
      current?.classList.remove('is-active');
      current = null;
      card.classList.remove('is-open');
      card.hidden = true;
    };
    const leafOf = (e: Event) => (e.target as Element | null)?.closest?.('.gt-leaf[data-id]') ?? null;
    // Mouse: hover. Touch and pen: tap a leaf to open, tap anywhere else to close.
    svg.addEventListener('pointerover', (e) => { if (e.pointerType === 'mouse') { const l = leafOf(e); if (l) showCard(l); } });
    svg.addEventListener('pointerout', (e) => {
      if (e.pointerType !== 'mouse') return;
      const from = leafOf(e);
      const to = (e.relatedTarget as Element | null)?.closest?.('.gt-leaf[data-id]');
      if (from && from !== to) hideTimer = window.setTimeout(hideCard, 80);
    });
    svg.addEventListener('click', (e) => { const l = leafOf(e); if (l) { l === current ? hideCard() : showCard(l); } });
    document.addEventListener('pointerdown', (e) => { if (current && !leafOf(e)) hideCard(); });
    // Keyboard (leaves become focusable in stage 7).
    svg.addEventListener('focusin', (e) => { const l = leafOf(e); if (l) showCard(l); });
    svg.addEventListener('focusout', hideCard);

    // ── Scroll: the glow follows the middle of the viewport along the trunk.
    // One rAF-throttled handler; it reads only scrollY and innerHeight (no
    // layout), moves one element, and toggles classes on the few leaves whose
    // state changed.
    const sync = (set: Set<Element>, next: Set<Element>, cls: string) => {
      for (const el of set) if (!next.has(el)) { el.classList.remove(cls); set.delete(el); }
      for (const el of next) if (!set.has(el)) { el.classList.add(cls); set.add(el); }
    };
    const onScroll = () => {
      ticking = false;
      if (!geometry) return;
      const mid = scrollY + innerHeight / 2 - stageTop; // viewport middle, in tree coordinates
      const onTree = mid > geometry.centerline[geometry.centerline.length - 1].y && mid < geometry.pot.y;
      const x = trunkXAt(geometry.centerline, mid);
      glow.style.transform = `translate3d(${(stageLeft + x).toFixed(1)}px, 0, 0)`;
      glow.classList.add('is-ready');
      glow.classList.toggle('is-off', !onTree);
      // Leaves near the glow brighten; leaves on or near screen sway.
      const nextLit = new Set<Element>();
      if (onTree) {
        const [l0, l1] = rangeByY(ys, mid - 150, mid + 150);
        for (let i = l0; i < l1; i++) if (Math.abs(byY[i].shape.x - x) < 260) nextLit.add(byY[i].el);
      }
      const nextNear = new Set<Element>();
      const top = scrollY - stageTop;
      const [n0, n1] = rangeByY(ys, top - 200, top + innerHeight + 200);
      for (let i = n0; i < n1; i++) nextNear.add(byY[i].el);
      sync(lit, nextLit, 'is-lit');
      sync(near, nextNear, 'is-near');
    };
    let ticking = false;
    // Swaying SVG leaves costs a layout per frame, so the sway pauses while the
    // page is scrolling and resumes a moment after it stops.
    let settle = 0;
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
      hideCard();
      stage.classList.add('is-scrolling');
      clearTimeout(settle);
      settle = window.setTimeout(() => stage.classList.remove('is-scrolling'), 200);
    }, { passive: true });

    // ── Layout: only when the panel's size changes, never on scroll.
    let lastKey = '';
    const draw = () => {
      const rect = stage.getBoundingClientRect();
      stageTop = rect.top + scrollY;
      stageLeft = rect.left;
      const width = Math.round(rect.width);
      const height = treeHeight(nodes.length);
      const key = `${width}x${height}`;
      if (key !== lastKey) {
        lastKey = key;
        stage.style.height = `${height}px`;
        geometry = layoutTree({ ...panelFrame({ width, height }), nodes, pinned, fallen });
        svg.setAttribute('width', String(width));
        svg.setAttribute('height', String(height));
        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
        svg.innerHTML = renderTree(geometry);
        const els = new Map([...svg.querySelectorAll('.gt-leaves .gt-leaf[data-id]')].map((el) => [el.getAttribute('data-id'), el]));
        byY = geometry.leaves.map((shape) => ({ shape, el: els.get(shape.leaf.id)! })).filter((x) => x.el).sort((a, b) => a.shape.y - b.shape.y);
        ys = byY.map((x) => x.shape.y);
        lit.clear();
        near.clear();
        hideCard();
      }
      onScroll();
    };
    let frame = 0;
    const schedule = () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(draw); };
    new ResizeObserver(schedule).observe(document.body);
    draw();
  }
</script>
