---
// Projects band. All panels are in the HTML; the script below hides all but
// the current one and wires arrows, dots, arrow keys and swipe. With JS off
// the panels stack and the controls stay hidden.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { formatRange } from '../lib/dates';

interface Props { projects: CollectionEntry<'projects'>[] }
const { projects } = Astro.props;
---
<section id="projects" class="section band band-case carousel">
  <div class="container"><h2 class="h2 section-title">Projects</h2></div>
  <div class="container carousel-wrap">
    <div class="carousel-row">
      <button class="arrow" type="button" data-prev aria-label="Previous project"><Icon name="chevron-left" size={18} /></button>
      <div class="panels" aria-live="polite">
        {projects.map((p, i) => (
          <a class="panel" href={`/projects/${p.id}`} data-index={i}>
            <div class="panel-grid">
              <Image class="panel-img" src={p.data.cover.src} alt={p.data.cover.alt} width={880} height={880} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
              <div class="panel-text">
                <p class="kicker">{formatRange(p.data.dates.start, p.data.dates.end)} · {p.data.role}</p>
                <h2 class="h2 panel-title">{p.data.title}</h2>
                <p class="body">{p.data.summary}</p>
                <p class="kicker">{p.data.stack.join(', ')}</p>
              </div>
            </div>
          </a>
        ))}
      </div>
      <button class="arrow" type="button" data-next aria-label="Next project"><Icon name="chevron-right" size={18} /></button>
    </div>
    <div class="dots">
      {projects.map((p, i) => (
        <button class="dot" type="button" data-dot={i} aria-label={`Show ${p.data.title}`} aria-current={i === 0 ? 'true' : undefined}></button>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('.carousel');
  if (root) {
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.panel'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    let current = 0;

    const show = (i: number, moved = true) => {
      current = Math.max(0, Math.min(panels.length - 1, i));
      panels.forEach((p, k) => (p.hidden = k !== current));
      dots.forEach((d, k) => (k === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
      prev.toggleAttribute('data-hidden', current === 0);
      next.toggleAttribute('data-hidden', current === panels.length - 1);
      if (moved) root.setAttribute('data-moved', '');
    };

    root.setAttribute('data-js', '');
    show(0, false);
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { show(current - 1); e.preventDefault(); }
      if (e.key === 'ArrowRight') { show(current + 1); e.preventDefault(); }
    });

    let startX = 0;
    let startY = 0;
    let swiped = false;
    root.addEventListener('pointerdown', (e) => { startX = e.clientX; startY = e.clientY; swiped = false; });
    root.addEventListener('pointerup', (e) => {
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(e.clientY - startY)) {
        swiped = true;
        show(dx < 0 ? current + 1 : current - 1);
      }
    });
    panels.forEach((p) => p.addEventListener('click', (e) => { if (swiped) e.preventDefault(); }));
  }
</script>
