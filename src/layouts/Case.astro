---
// Case-study page: collage left, article right, shared nav and footer.
// Behind it, faint and decorative: a drawing taken from the project
// (<slug>/art.svg) and, on wide screens, a strip of the project's real code
// in the right margin (<slug>/excerpt.txt). Either file may be absent.
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import Collage from '../components/Collage.astro';
import { site } from '../data/site';
import { formatRange } from '../lib/dates';

interface Props { project: CollectionEntry<'projects'>; next: CollectionEntry<'projects'> }
const { project, next } = Astro.props;
const { data } = project;
const arts = import.meta.glob<string>('../content/projects/*/art.svg', { query: '?raw', import: 'default', eager: true });
const codes = import.meta.glob<string>('../content/projects/*/excerpt.txt', { query: '?raw', import: 'default', eager: true });
const art = arts[`../content/projects/${project.id}/art.svg`]?.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const code = codes[`../content/projects/${project.id}/excerpt.txt`];
---
<Base title={`${data.title} — ${site.name}`} description={data.tagline} page="case" ogImage={`/og/${project.id}.png`}>
  <div class="case-page">
  {art && <div class="case-art"><Fragment set:html={art} /></div>}
  {code && <pre class="case-code" aria-hidden="true">{code}</pre>}
  <div class="container case" style={`--project-link: var(--project-${project.id}-link)`}>
    <Collage title={data.title} slug={project.id} photos={data.collage} />
    <article class="article">
      <header class="case-header">
        <h1>{data.title}</h1>
        <p class="lede">{data.tagline}</p>
        <dl class="meta">
          {data.role && <><dt class="kicker">Role</dt><dd>{data.role}</dd></>}
          <dt class="kicker">Team</dt><dd>{data.team}</dd>
          <dt class="kicker">Dates</dt><dd>{formatRange(data.dates.start, data.dates.end)}</dd>
          <dt class="kicker">Status</dt><dd>{data.status}</dd>
        </dl>
        <div class="links-row">
          {data.private
            ? <span>Private repository: architecture and screenshots below</span>
            : data.repo && <a href={data.repo} target="_blank" rel="noopener">Code on GitHub</a>}
          {data.demo && <a href={data.demo} target="_blank" rel="noopener">Live</a>}
          <a href={site.resume} target="_blank" rel="noopener">Resume</a>
        </div>
      </header>
      <slot />
      <p class="kicker next">Next: <a href={`/projects/${next.id}`}>{next.data.title}</a></p>
    </article>
  </div>
  </div>
</Base>
